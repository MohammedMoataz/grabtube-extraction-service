# GrabTube Extraction Service — configuration (all optional; defaults shown)

# Comma-separated allow-list of explicit origins permitted via CORS. Empty = deny all cross-origin.
GT_CORS_ORIGINS=

# Global pool of concurrent media conversions; jobs beyond this wait in "queued".
GT_MAX_CONCURRENCY=4

# Per-IP rate limits (requests per minute). Status polling is unthrottled.
GT_RATE_JOBS_PER_MIN=10
GT_RATE_RESOLVE_PER_MIN=30

# Minutes a completed result is retained before the sweeper deletes it.
GT_RETENTION_MINUTES=30

# Timeouts (seconds).
GT_RESOLVE_TIMEOUT_S=30
GT_JOB_TIMEOUT_S=1800

# Where transient artifacts are written. Empty = system temp dir.
GT_TMP_DIR=

# Listen port.
GT_PORT=8080

# Optional operator egress config (server-side only, never exposed to clients).
GT_PROXY_URL=
GT_COOKIES_FILE=

# Header holding the real client IP, set by a trusted proxy (e.g. cf-connecting-ip behind a
# Cloudflare tunnel). Empty = rate-limit by the direct peer address. X-Forwarded-For is never trusted.
GT_CLIENT_IP_HEADER=
